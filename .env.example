# --- Database ---
# Local dev: docker compose up -d  (matches docker-compose.yml credentials below)
DATABASE_URL="postgresql://evenly:evenly_dev_password@localhost:5432/evenly?schema=public"

# Amazon RDS: append ?sslmode=require to the URL, e.g.
#   postgresql://evenly:PASSWORD@evenly-db.xxxx.ap-south-1.rds.amazonaws.com:5432/evenly?schema=public&sslmode=require
# and set DATABASE_CA_CERT to the contents of the RDS global CA bundle:
#   curl -O https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# In production the app refuses to start with sslmode=require but no CA, rather
# than silently falling back to an unverified TLS connection.
DATABASE_CA_CERT=""

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# The full public origin this instance is served from, with no trailing slash.
# Required in production. Auth.js builds its callback URLs from it, the Gmail
# integration builds its redirect URI from it, and Auth.js treats its presence
# as permission to trust the incoming Host header. Left unset on a deployed
# server the app refuses to start, because the alternative is OAuth redirects
# silently pointing at localhost.
#   local:   http://localhost:3000
#   Amplify: https://main.d1234abcd.amplifyapp.com  (or your custom domain)
AUTH_URL="http://localhost:3000"

# Google OAuth (optional, email/password auth works without these).
# Setting these also enables Settings > Gmail auto-import (reuses this same
# client — no separate credentials needed) as long as the Gmail API is
# enabled and the "https://www.googleapis.com/auth/gmail.readonly" scope is
# added on the OAuth consent screen for this project. See README for the
# full free setup walkthrough.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI provider (optional) ---
# If no key is set, AI-dependent features are disabled and the UI shows a
# graceful "AI features are currently unavailable" message instead of failing.
AI_PROVIDER="groq"

# Groq. Groq exposes an OpenAI-compatible API,
# so this is talked to via the `openai` SDK pointed at Groq's base URL.
# GROQ_VISION_MODEL powers the AI bill scanner specifically and must be one
# of the (few) models on your account with image input support; if it's
# ever retired, receipt scanning falls back to manual entry gracefully
# rather than failing the upload. Groq's lineup changes often, list what
# your key can actually access with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# --- File storage ---
# "local" writes to the filesystem and is for development only: managed and
# serverless hosting gives each instance a read-only filesystem outside /tmp,
# and discards /tmp between invocations, so uploaded receipts would be
# accepted and then lost. Production must use "s3", and the app refuses to
# start with "local" when NODE_ENV=production.
# S3_ENDPOINT is only needed for S3-compatible services that are not AWS S3;
# leave it empty for AWS.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- PayPal Sandbox demo (optional) ---
# Adds a "Pay with PayPal" button (labelled "PayPal Sandbox Demo") to suggested settlements.
# SANDBOX ONLY. The payment goes to the sandbox *merchant* account below; it does not move
# money to the other group member. Leave these empty to hide the feature. See README
# ("PayPal Sandbox Demo") for the dashboard setup.
#
# The client ID is the only public value (it is embedded in the browser bundle, so changing it
# needs a rebuild). The secret and merchant ID stay on the server.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Merchant ID of the sandbox Business account that receives the money (Sandbox accounts >
# the business account > Account details). Orders are created for, and verified against, it.
PAYPAL_MERCHANT_ID=""
# Must be the sandbox host; any other value is rejected.
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
# PayPal cannot charge INR. The sandbox charge is made in this currency (a two-decimal
# currency from PayPal's supported list).
PAYPAL_CHARGE_CURRENCY="USD"
# Fixed demo rate: units of the group's currency per 1 unit of PAYPAL_CHARGE_CURRENCY,
# e.g. 83 means INR 83 = USD 1. Required whenever the group currency (default INR) differs
# from PAYPAL_CHARGE_CURRENCY. There is no built-in default and no live rate lookup.
PAYPAL_DEMO_EXCHANGE_RATE=""
