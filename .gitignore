# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# The RDS CA bundles are public certificates, not secrets, and the server needs
# them at runtime to verify the database's TLS certificate. They must ship with
# the deployment: the app refuses to connect to production unverified, and the
# bundle is far too large to pass as an environment variable.
!prisma/rds-ca-*.pem
# ...except the 165KB all-regions bundle, which is only useful locally. The
# region certificate above is the one the deployment needs.
prisma/rds-ca-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template documents which vars are required and holds no secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local file storage (dev)
/storage/uploads

# Editor/agent tooling, regenerated locally by `next dev`
AGENTS.md
